{% extends '/layouts/base.twig' %}

{% block content %}

<form method="POST" action="/contact">
<fieldset>
    <legend><span aria-hidden="true">📬</span> Contact Me</legend>
    <label>Your Email</label>
    <input name="email" type="email" placeholder="me@avrism.xyz">
    <label>Message</label>
    <textarea name="message" type="text"></textarea><br>
    <button type="submit" class="btn"><span aria-hidden="true">📨</span> Submit</button>
</fieldset>
</form>

<hr>

{% endblock %}